# Copy to .env and adjust for local development. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=microlearning
POSTGRES_PASSWORD=microlearning
POSTGRES_DB=microlearning
DATABASE_URL=postgresql://microlearning:microlearning@postgres:5432/microlearning

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API (services/api) ---
API_ENV=development
API_PORT=8000
# Comma-separated list of allowed frontend origins. The local default
# covers the Vite dev server; a real deployment sets this to the real
# frontend origin(s) (see docs/operations/DEPLOYMENT.md).
CORS_ORIGINS=http://localhost:5173
# Dev-only placeholder — a real deployment MUST override this with a
# real random secret (Render's Blueprint auto-generates one; see
# docs/operations/SECURITY_REVIEW.md #2).
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production
# Same deal as JWT_SECRET_KEY - a real deployment MUST override this.
# Sent as the X-Admin-Key header on every /admin/* request (user
# renames, hiding a user from /leaderboard).
ADMIN_API_KEY=dev-only-insecure-admin-key-change-in-production

# --- Worker (services/worker) ---
WORKER_ENV=development

# --- Web (apps/web) ---
# Base URL the browser uses to reach the API. Locally this is routed
# through NGINX; in a deployment with no such proxy (e.g. Vercel), this
# must be the backend's real public URL instead (see
# docs/operations/DEPLOYMENT.md).
VITE_API_BASE=/api

# --- Question sources ---
OPENTDB_BASE_URL=https://opentdb.com/api.php
QUIZAPI_BASE_URL=https://quizapi.io/api/v1/questions
# Free key from https://quizapi.io - never commit the real value.
QUIZAPI_KEY=
